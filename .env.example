# AI provider — any OpenAI-compatible endpoint. Chat and embeddings share these.
# Google AI Studio key: https://aistudio.google.com/apikey
API_KEY=
# Google AI Studio: https://generativelanguage.googleapis.com/v1beta/openai/
# Groq:             https://api.groq.com/openai/v1
# OpenAI:           https://api.openai.com/v1
# OpenRouter:       https://openrouter.ai/api/v1
# Ollama:           http://localhost:11434/v1
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Default chat model. Overridable per request from the model picker in the chat UI.
AI_MODEL=gemini-flash-latest
# Embedding model for the pgvector schema-metadata store used by text-to-SQL.
EMBEDDING_MODEL=gemini-embedding-001
# Vector width of EMBEDDING_MODEL. gemini-embedding-001=3072,
# text-embedding-3-small=1536. Changing it requires `python -m backend.seed`.
EMBEDDING_DIM=3072

# Postgres (Supabase or local). Driver must be psycopg (v3).
# Supabase: postgresql+psycopg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:devpass@127.0.0.1:55432/logistics
# Hard ceiling on any AI-generated query, in milliseconds.
SQL_TIMEOUT_MS=5000
# A text column with at most this many distinct values gets them listed in the
# generated DDL context, so the planner filters on real literals.
MAX_UNIQUE_VALUES=50

# Browser origins allowed to call this API, comma-separated (the Next.js app).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth
SECRET_KEY=change_me_to_a_long_random_value
SUPER_USERNAME=
SUPER_PASSWORD=
